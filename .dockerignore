# ============================================================
# .dockerignore — Frontend Next.js / React (dbcapibara-next)
# El Dockerfile se mantiene en el contexto de build.
# ============================================================

# Agentes / editores / IA (pedidos)
.agents
.atl
.claude
.cursor

# Build de Next.js y Vercel (pedidos)
.next
.vercel

# Node / gestores de paquetes
node_modules
.pnpm-store
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentación y markdown (no van en la imagen)
*.md

# Entorno local y secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# Control de versiones y config de repo
.git
.gitignore
.gga

# Cache y build artifacts
.pytest_cache
tsconfig.tsbuildinfo
coverage
*.log

# OS
.DS_Store
Thumbs.db

# Locks y config de workspace (node_modules ya queda excluido)
package-lock.json
pnpm-lock.yaml
pnpm-workspace.yaml

# Documentación / specs internas
docs
openspec
sdd

# Asegura que el Dockerfile nunca quede excluido del contexto
!Dockerfile
